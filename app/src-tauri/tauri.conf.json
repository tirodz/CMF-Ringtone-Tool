{
  "productName": "CMF Ringtone Tool",
  "version": "1.0.0",
  "identifier": "com.cmf.ringtone-tool",
  "build": {
    "frontendDist": "../",
    "devUrl": "http://localhost:1420"
  },
  "app": {
    "withGlobalTauri": true,
    "windows": [
      {
        "title": "CMF Ringtone Tool",
        "resizable": false,
        "width": 1040,
        "height": 700,
        "maximized": false,
        "decorations": false
      }
    ],
    "security": {
      "csp": "default-src 'self'; img-src 'self' data:; style-src 'self' 'unsafe-inline'; script-src 'self'"
    }
  },
  "bundle": {
    "active": true,
    "targets": ["nsis"],
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.ico"
    ]
  },
  "plugins": {
    "updater": {
      "active": true,
      "endpoints": [
        "https://github.com/tirodz/CMF-Ringtone-Tool/releases/latest/download/latest.json"
      ],
      "pubkey": "SIGNING_PUBKEY_PLACEHOLDER"
    }
  }
}
